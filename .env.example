# Backend secrets — DO NOT commit this file to Git
# Add all of these in Vercel Dashboard → Project Settings → Environment Variables

SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
JWT_SECRET=your_jwt_secret_here
PORT=8000

# Frontend — this is inlined at build time by Vite
# When deployed on Vercel, VITE_BACKEND_URL should be empty (same domain)
VITE_BACKEND_URL=
